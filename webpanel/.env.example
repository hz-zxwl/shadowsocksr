SSR_PANEL_SECRET=replace-with-a-long-random-value
SSR_PANEL_USERNAME=admin
SSR_PANEL_PASSWORD=replace-with-a-strong-password
SSR_MUDB_PATH=/opt/shadowsocksr/mudb.json
SSR_SERVICE_NAME=shadowsocksr
SSR_CONTROL_SCRIPT=/etc/init.d/ssrmu
SSR_LOG_PATH=/usr/local/shadowsocksr/ssserver.log
SSR_LOG_LINES=200
SSR_PANEL_BIND=0.0.0.0
SSR_PANEL_PORT=65432
SSR_PUBLIC_HOST=
